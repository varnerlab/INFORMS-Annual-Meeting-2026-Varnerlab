\newcommand{\paperfigcolors}{%
  \definecolor{vndotoff}{HTML}{3F7FBF}%
  \definecolor{vndoton}{HTML}{1B3F66}%
  \definecolor{vndotbar}{HTML}{E2E8EF}%
  \definecolor{vndotew}{HTML}{6F7C89}%
  \definecolor{vndotgrid}{HTML}{E9EDF2}%
  \definecolor{vndotaxis}{HTML}{9AA6B2}%
  \definecolor{vndottick}{HTML}{3D4752}%
  \definecolor{vnband}{HTML}{3E8ED0}%
  \definecolor{vnmpcred}{HTML}{D9432F}%
}
% the deck's footer macros, unused on paper
\newcommand{\vnfootleft}{}
\newcommand{\vnfootskip}{0.9em}
